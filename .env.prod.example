# Copy to .env.prod and replace every placeholder before running production compose.

API_PROXY_HTTP_PORT=80
PUBLIC_BASE_URL=https://www.pekora.zip
CDN_BASE_URL=https://www.pekora.zip
IS_CDN_ENABLED=false
PUBLIC_HOST_PRIMARY=pekora.zip
PUBLIC_HOST_WWW=www.pekora.zip
PUBLIC_HOST_EXTRA=

# External dependency mode. For docker-hosted local rehearsal, use docker-compose.prod.local-deps.yml.
POSTGRES_CONNECTION=Host=your-postgres-host;Port=5432;Database=korone;Username=korone;Password=replace-me
REDIS_CONNECTION=your-redis-host:6379
REDIS_AUTHENTICATION=

# Migration compatibility variables. Use DATABASE_URL, or DB_* values.
DATABASE_URL=
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=korone
DB_PASS=replace-me
DB_NAME=korone

# Optional local-deps override values.
LOCAL_POSTGRES_USER=roblox
LOCAL_POSTGRES_PASSWORD=replace-me
LOCAL_POSTGRES_DB=economy

INTERNAL_SERVICE_AUTHORIZATION=replace-me-internal-service-token
RCC_AUTHORIZATION=replace-me-rcc-token
JWT_SESSIONS_SECRET=replace-me-long-session-signing-secret
BOT_AUTHORIZATION=replace-me-bot-token
RENDER_AUTHORIZATION=replace-me-render-token
ASSET_VALIDATION_AUTHORIZATION=replace-me-asset-validation-token

HCAPTCHA_PUBLIC=replace-me-hcaptcha-public
HCAPTCHA_PRIVATE=replace-me-hcaptcha-private
OWNER_USER_ID=1
PACKAGE_SHIRT_ASSET_ID=0
PACKAGE_PANTS_ASSET_ID=0
LEAKCHECK_API_KEY=
TWITTER_BEARER=

DISCORD_DONATION_WEBHOOK_URL=
STRIPE_WEBHOOK_SECRET=
KOFI_VERIFICATION_TOKEN=
REWARBLE_API_KEY=replace-me-rewarble-api-key
REWARBLE_BASE_URL=https://api.rewarble.com
REWARBLE_TEST_MODE=false

GAME_RENDERER_HTTP_PORT=3043
GAME_RENDERER_RDESKTOP_PORT=16612
GAME_SERVER_THUMBNAIL_WS_PORT=3189
RENDERER_DEBUG=false
PORT_RCC_PLAYER=1621,5621,8621,8622,8624,8629,9000,9002,10000,11000,12000
PORT_RCC_IMAGE=2621,2622,4853,5121,5231
PORT_RCC_PLACE=3621,3622,8495,9400,9500
PORT_RCC_CATALOG=4621,7621,9621,4324,5421
