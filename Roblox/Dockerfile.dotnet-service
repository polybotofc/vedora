FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src
COPY . .

ARG PROJECT_PATH
RUN dotnet publish "$PROJECT_PATH" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

# Npgsql pulls in System.Net.Security's GSSAPI (Kerberos) P/Invoke, which needs
# libgssapi_krb5.so.2. The aspnet base image ships no Kerberos runtime, so every
# service that opens a Postgres connection crashes at startup with
# "libgssapi_krb5.so.2: cannot open shared object file" unless it is installed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG ASSEMBLY_NAME
ENV ASSEMBLY_NAME=$ASSEMBLY_NAME

COPY --from=build /app/publish ./
COPY --from=build /src/Roblox/Roblox.Libraries/Templates ./Roblox/Roblox.Libraries/Templates
COPY --from=build /src/Roblox/Roblox.Libraries/Json ./Roblox/Roblox.Libraries/Json
COPY --from=build /src/Roblox/Roblox.Libraries/StudioScripts ./Roblox/Roblox.Libraries/StudioScripts
COPY --from=build /src/Roblox/Roblox.Rendering/internalscripts ./Roblox/Roblox.Rendering/internalscripts
COPY --from=build /src/admin/public ./admin/public

CMD ["sh", "-c", "dotnet ${ASSEMBLY_NAME}.dll"]
